# ---- Server ----
PORT=8787
# Required in production: long random string used to sign login tokens.
AUTH_SECRET=
# How long a login lasts, in days.
SESSION_DAYS=180
# Where the JSON database lives.
DATA_DIR=./.data
# 'console' (dev: OTP shown in the app and server log) or 'msg91' (production SMS).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Web app (read at build time by Vite) ----
# From AdSense > Ads > By ad unit. Leave empty to show a placeholder box.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
