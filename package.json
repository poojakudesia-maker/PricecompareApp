{
  "name": "quickhai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.ts & vite --host",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite --host",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production node server/index.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
